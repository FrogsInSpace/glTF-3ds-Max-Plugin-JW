<?xml version="1.0" encoding="utf-8"?>
<Project
    ToolsVersion="Current"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ThirdPartyRoot>$(MSBuildThisFileDirectory)</ThirdPartyRoot>
    <ThirdPartyLibDir>$(MSBuildThisFileDirectory)_dist_v141\Release</ThirdPartyLibDir>
    <ThirdPartyLibDir Condition="$(Configuration.Contains('Hybrid')) OR $(Configuration.Contains('Debug'))">$(MSBuildThisFileDirectory)_dist_v141\Debug</ThirdPartyLibDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>
				$(MSBuildThisFileDirectory)draco\installed\include;
				$(MSBuildThisFileDirectory)jsoncpp\include;
				$(MSBuildThisFileDirectory)KTX-Software\include;
				$(MSBuildThisFileDirectory)KTX-Software\lib;
				$(MSBuildThisFileDirectory)libwebp\src;
				$(MSBuildThisFileDirectory)tinygltf\attic;		
				%(AdditionalIncludeDirectories)
			</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(ThirdPartyLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
</Project>